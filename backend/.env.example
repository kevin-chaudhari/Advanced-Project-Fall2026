# LLM Provider: "ollama" or "openai"
LLM_PROVIDER=openai

# Ollama settings (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI settings (if using OpenAI)
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=8192

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS index persistence path
FAISS_INDEX_PATH=./faiss_indexes

# AFRB dataset path (preloaded CSV, optional)
AFRB_CSV_PATH=./data/afrb_sample.csv

# Logging
LOG_LEVEL=INFO

# CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Harness settings ─────────────────────────────────────────────
# Synthetic AFRB knowledge base (clearly labelled SYNTHETIC, separate FAISS index)
AFRB_SYNTHETIC_CSV_PATH=./data/synthetic/afrb_synthetic.csv
# auto = use the LLM when configured; false = deterministic agents only
HARNESS_USE_LLM=auto
# maximum targeted re-retrieval rounds in the feedback loop
MAX_FEEDBACK_ROUNDS=2
# legacy LLM meta-evaluation of every query (slow, costs tokens)
SYSTEM_ANALYSIS_LLM=false
