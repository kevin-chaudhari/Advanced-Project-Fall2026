## 6. Database Schema & Persistence Flow

```mermaid
erDiagram
    ANALYSIS_RESULTS {
        INTEGER id PK
        TEXT created_at
        TEXT question
        TEXT dataset
        TEXT final_diagnosis
        REAL confidence
        REAL latency_ms
        REAL overall_score
        TEXT risk_level
        TEXT analysis_json
    }

    FAISS_INDEX_STORE {
        FILE failure_iq_faiss "384-dim L2 index"
        FILE failure_iq_docs_pkl "List of doc dicts"
        FILE afrb_faiss "384-dim L2 index"
        FILE afrb_docs_pkl "List of doc dicts"
    }

    ANALYSIS_RESULTS ||--o{ INLINE_EVALUATION : "analysis_json contains"
    INLINE_EVALUATION {
        TEXT reference_conclusion
        FLOAT faithfulness_score
        FLOAT reasoning_score
        FLOAT agreement_score
        FLOAT coverage_score
        FLOAT hallucination_rate
        FLOAT confidence_final
        TEXT final_verdict
        LIST per_agent_evaluations
    }

    INLINE_EVALUATION ||--|{ AGENT_GROUNDING_EVAL : "per_agent_evaluations[]"
    AGENT_GROUNDING_EVAL {
        TEXT agent_key
        FLOAT faithfulness_score
        FLOAT reasoning_score
        FLOAT agreement_score
        FLOAT coverage_score
        FLOAT hallucination_rate
        FLOAT reliability_score
        TEXT verdict
    }
```

